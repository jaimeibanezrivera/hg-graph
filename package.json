{
  "name": "hg-graph",
  "displayName": "Hg Graph",
  "description": "A graphical changeset graph for Mercurial, with topic and branch lanes.",
  "version": "0.9.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:hgGraph.open",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hgGraph.open",
        "title": "Hg Graph: Open",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "hgGraph.open",
          "group": "navigation",
          "when": "scmProvider == hg"
        }
      ],
      "commandPalette": [
        {
          "command": "hgGraph.open"
        }
      ]
    },
    "configuration": {
      "title": "Hg Graph",
      "properties": {
        "hgGraph.maxCommits": {
          "type": "integer",
          "default": 500,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum number of changesets displayed."
        },
        "hgGraph.laneWidth": {
          "type": "integer",
          "default": 40,
          "minimum": 16,
          "maximum": 120,
          "description": "Horizontal spacing in pixels between graph lanes."
        },
        "hgGraph.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show an Hg Graph button in the status bar when the workspace contains a Mercurial repository."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "license": "MIT"
}
